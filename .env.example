# 运行 npm run setup:env 生成 .env.local 并填入随机密钥。
# 浏览器实际访问的完整站点地址；部署后需修改为对应域名或 IP 与端口。
# 以下为本地开发地址；Docker 直接访问时默认端口为 30010，域名部署时填写实际 HTTPS 地址。
BETTER_AUTH_URL=http://127.0.0.1:3000
# 额外允许的完整访问地址，以逗号分隔；主地址自动允许，留空保持单入口。
# 例如：https://nav.example.com,http://198.51.100.10:30010。不能包含路径或通配符。
# 同一主机及端口只配置一种协议；域名与 IP 各自登录，共用账号和数据。
ALLOWED_ORIGINS=
# 会话签名密钥，至少 32 个字符；与初始化密钥分开生成并妥善保管。
BETTER_AUTH_SECRET=
# 仅首次创建管理员时使用，已有管理员后初始化入口会关闭。
SETUP_TOKEN=
# SQLite 文件路径；上传图片保存在同级 uploads 目录，备份时也需复制该目录。
DATABASE_PATH=./data/nav-palace.db
# Docker 宿主机监听地址；仅反向代理用 127.0.0.1，需要公网 IP 直连用 0.0.0.0。
HOST_IP=127.0.0.1
# Docker 映射到宿主机的端口，容器内固定使用 3000。
PORT=30010
