# 运行 npm run setup:env 生成带随机密钥的 .env.local；以下密钥项留空。
# 浏览器实际访问的完整站点地址；部署后需修改为对应域名或 IP 与端口。
BETTER_AUTH_URL=https://nav.example.com
# 会话签名密钥，至少 32 个字符；与初始化密钥分开生成并妥善保管。
BETTER_AUTH_SECRET=
# 仅首次创建管理员时使用，已有管理员后初始化入口会关闭。
SETUP_TOKEN=
# SQLite 文件路径；上传图片保存在同级 uploads 目录，备份时也需复制该目录。
DATABASE_PATH=./data/nav-palace.db
# Docker 在宿主机上的监听地址。与反向代理同机部署时可保留 127.0.0.1。
HOST_IP=127.0.0.1
# Docker 映射到宿主机的端口，容器内固定使用 3000。
PORT=3000
