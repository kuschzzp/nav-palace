{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nav-palace",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "nav-palace" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nav-palace",
      // 创建 D1 后，将此值替换为命令输出的真实数据库 ID。
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "nav-palace-uploads" }
  ],
  "images": { "binding": "IMAGES" },
  // 登录与私密密码使用 scrypt，需启用 Workers Paid 并预留密码计算时间。
  "limits": { "cpu_ms": 30000 },
  "vars": {
    // 部署前改为浏览器实际访问的完整 HTTPS 地址。
    "BETTER_AUTH_URL": "https://nav.example.com"
  },
  "observability": { "enabled": true }
}
